# 1. 忽略依赖包（这是导致你刚才刷屏的元凶，必须有）
node_modules/
/dist
/dist-ssr

# 2. 忽略日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. 忽略本地环境变量文件（保护你的 API Key 不泄露）
.env
.env.local
.env.*.local
*.local

# 4. 忽略编辑器配置（防止你的个人设置影响其他同学）
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?