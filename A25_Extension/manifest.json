{
  "manifest_version": 3,
  "name": "A25 智慧助教 (学习通·雨课堂)",
  "version": "1.1",
  "description": "在学习通、雨课堂网页中注入 A25 悬浮 AI 助教，并抓取课件画面供答疑与出题",
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.yuketang.cn/*",
        "*://yuketang.cn/*",
        "*://*.ykt.io/*",
        "*://ykt.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}